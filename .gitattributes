# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.jar binary
*.war binary

# Text files
*.java text
*.ts text
*.tsx text
*.js text
*.jsx text
*.css text
*.html text
*.json text
*.xml text
*.yml text
*.yaml text
*.sql text
*.md text
